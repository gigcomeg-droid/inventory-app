# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# This project uses PostgreSQL (prisma/schema.prisma provider = "postgresql")
# so it can run both locally and on a host like Vercel with a real online
# database (e.g. Neon / Vercel Postgres). Use the SAME connection string for
# local dev and production unless you deliberately want separate databases.
#
# Local Postgres example:
# DATABASE_URL="postgresql://inventory_user:CHANGE_ME@localhost:5432/inventory_db?schema=public"
#
# Neon / Vercel Postgres example (copy the exact strings from their dashboard —
# they already include sslmode=require):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# If your Postgres only gives you ONE connection string (e.g. plain local
# Postgres, no pooler), just set DIRECT_URL to the same value as DATABASE_URL.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Random long secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Session cookie lifetime, in seconds (default 8 hours)
SESSION_MAX_AGE=28800

# ---------------------------------------------------------------------------
# Automatic backups (Vercel Cron)
# ---------------------------------------------------------------------------
# Shared secret that authorizes the scheduled backup job (see vercel.json's
# `crons` entry + app/api/backups/run/route.js). Only needed when deployed
# to Vercel — set the SAME value here and as an Environment Variable in
# the Vercel project settings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
